{
  "name": "@carbid/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Platform-agnostic design tokens for the CarBid web and React Native apps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind-preset.cjs": "./tailwind-preset.cjs",
    "./dist/*": "./dist/*"
  },
  "files": ["dist", "tailwind-preset.cjs"],
  "scripts": {
    "build": "tsup src/index.ts src/colors.ts src/typography.ts src/layout.ts --format esm,cjs --dts --clean",
    "build:css": "tsx scripts/generate-css.ts",
    "verify:contrast": "tsx scripts/verify-contrast.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
